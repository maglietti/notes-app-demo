# Copy to .env and adjust. Real environment variables override these values.
NOTES_APP_DB_HOST=127.0.0.1
NOTES_APP_DB_PORT=3310
NOTES_APP_DB_USER=root
NOTES_APP_DB_PASSWORD=demo-pw
NOTES_APP_DB_NAME=notes_app
NOTES_APP_ACCOUNT_EMAIL=michael.aglietti@mariadb.com

# Data mode: native (default, direct to the tables) or rest (needs a REST router).
NOTES_APP_MODE=native
# REST Service root, used only when NOTES_APP_MODE=rest.
NOTES_APP_REST_URL=http://127.0.0.1:8443/notesApp
