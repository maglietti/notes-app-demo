#!/usr/bin/env bash
# Stable entry point for the Notes App TUI.
#
# The app is a notes_app package at the repository root (generated by the demo,
# see the README). This launcher is committed scaffolding, so it gives one
# memorable command to run on stage and never changes.
#
# Contract: the app must be runnable as `python -m notes_app` from the repo root.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ ! -d "$repo_root/notes_app" ] && [ ! -f "$repo_root/pyproject.toml" ]; then
  echo "notes-app: no app at the repo root yet — run the demo prompts to build it first." >&2
  exit 1
fi

cd "$repo_root"

# Native mode is the demo default; override with NOTES_APP_MODE=rest before the call.
export NOTES_APP_MODE="${NOTES_APP_MODE:-native}"

# Prefer uv when the app ships a pyproject; fall back to the interpreter directly.
if command -v uv >/dev/null 2>&1 && [ -f pyproject.toml ]; then
  exec uv run python -m notes_app "$@"
else
  exec python3 -m notes_app "$@"
fi
