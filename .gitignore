# This repository holds the INSTRUCTIONS for generating the app, not the app.
# Everything the prompts, the agent, or a build produce is ignored, so the repo
# stays clean and `git clean -fdx` returns it to a pristine, re-runnable state.

# Prompt 2 output: the generated Textual app at the repository root
/notes_app/
/pyproject.toml
/uv.lock
/.env
/.env.example

# Prompt 1 and 3 output: schema, REST DDL, run log, and the sandbox data directory
working/

# Python build and bytecode
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments and tool caches
.venv/
venv/
env/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# macOS
.DS_Store
