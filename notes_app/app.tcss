#panes {
    height: 1fr;
}

#notebooks, #notes, #note-pane {
    border: round $primary-darken-2;
    height: 1fr;
}

#notebooks:focus, #notes:focus, #note-pane:focus {
    border: round $accent;
}

#notebooks {
    width: 24;
}

#notes {
    width: 2fr;
}

#note-pane {
    width: 3fr;
    padding: 0 1;
}

#status {
    height: 1;
    padding: 0 1;
    background: $boost;
}

#editor {
    height: 1fr;
    padding: 0 1;
}

#editor-heading {
    padding: 1 0 0 0;
    text-style: bold;
}

#edit-body {
    height: 1fr;
}

.dialog {
    width: 70;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

.dialog.help {
    width: 80;
    max-height: 90%;
}

ConfirmScreen, SearchScreen, HelpScreen {
    align: center middle;
}
